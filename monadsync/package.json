{
	"name": "monadsync",
	"version": "0.0.1",
	"type": "module",
	"description": "Combines Mnemonad (on-chain append-only storage on Monad) with DoubleSync (CDC delta sync) to store and replay folder-tree snapshots on-chain.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeka911/mnemonad.git",
		"directory": "monadsync"
	},
	"main": "./index.js",
	"types": "./index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		}
	},
	"files": [
		"MonadSync.js",
		"index.js",
		"index.d.ts",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "osv-guard vitest run ./test/*.test.js"
	},
	"keywords": [
		"monad",
		"mnemonad",
		"doublesync",
		"sync",
		"cdc",
		"evm",
		"web3"
	],
	"license": "AGPL-3.0",
	"peerDependencies": {
		"viem": "^2.0.0"
	},
	"dependencies": {
		"mnemonad": "workspace:^",
		"@fizzyflow/doublesync": "^0.1.1"
	},
	"devDependencies": {
        "osv-guard": "^0.2.1",
		"viem": "^2.56.3",
		"vitest": "^4.1.11"
	}
}
