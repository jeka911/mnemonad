# Pinata JWT with pinning-write scope. Required — the server refuses to start without it.
# This is an admin credential: it never reaches a browser, which is the whole point of
# this service existing.
PINATA_JWT=

# Chain. Defaults to Monad testnet; REGISTRY_ADDRESS defaults to whatever mnemonad's
# ids.js records for this chainId, so it normally needs no value.
CHAIN_ID=10143
# RPC_URL=https://testnet-rpc.monad.xyz
# REGISTRY_ADDRESS=

HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Comma-separated origins for the explorer. Omit to disable CORS entirely.
# CORS_ORIGIN=http://localhost:5173

# How long an issued upload URL stays valid.
URL_TTL_SECONDS=120

# Safety gap before the on-chain escrow expires. Load-bearing: past the escrow's expiry a
# payer can refund(), so a URL outliving it would mean a free upload.
ESCROW_MARGIN_SECONDS=60

# URLs one escrow may be issued. >1 so a dropped upload doesn't strand a payer; bounded
# because each costs a duplicate upload of already-paid-for bytes.
MAX_ISSUES_PER_REQUEST=3

MAX_SIGNATURE_WINDOW_SECONDS=300
MAX_UPLOAD_BYTES=1073741824
# LEDGER_PATH=./data/issued.jsonl

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
