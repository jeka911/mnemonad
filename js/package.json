{
    "name": "mnemonad",
    "version": "0.0.1",
    "description": "Scalable append-only on-chain stream for Monad with IPFS offloading and client-side encryption",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeka911/mnemonad.git",
        "directory": "js"
    },
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "sideEffects": false,
    "files": [
        "Mnemonad.js",
        "MnemonadCrypto.js",
        "MnemonadItem.js",
        "MnemonadRateLimiter.js",
        "MnemonadChunkCache.js",
        "MnemonadRpcRecorder.js",
        "MnemonadUploadGateway.js",
        "offloading/",
        "abi.js",
        "gatewayAbi.js",
        "ids.js",
        "metaCodec.js",
        "streamMeta.js",
        "itemMeta.js",
        "index.js",
        "index.d.ts",
        "LICENSE"
    ],
    "keywords": [
        "mnemonad",
        "monad",
        "stream",
        "database",
        "storage",
        "evm",
        "viem",
        "web3",
        "dapps",
        "dapp"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "AGPL-3.0",
    "scripts": {
        "test": "osv-guard vitest run ./test/*.test.js",
        "test:base": "osv-guard vitest run ./test/base.test.js",
        "test:large-data": "osv-guard vitest run ./test/large_data.test.js",
        "test:huge-data": "osv-guard vitest run ./test/huge_data.test.js",
        "test:encrypted-small": "osv-guard vitest run ./test/encrypted_small.test.js",
        "test:encrypted-large": "osv-guard vitest run ./test/encrypted_large.test.js",
        "test:encrypted-huge": "osv-guard vitest run ./test/encrypted_huge.test.js",
        "test:mixed-tiers": "osv-guard vitest run ./test/mixed_tiers.test.js",
        "test:list-owned": "osv-guard vitest run ./test/list_owned.test.js",
        "test:rate-limiter": "osv-guard vitest run ./test/rate_limiter.test.js",
        "test:rate-limiter-retry": "osv-guard vitest run ./test/rate_limiter_retry.test.js",
        "test:custom-offloading-provider": "osv-guard vitest run ./test/custom_offloading_provider.test.js",
        "test:upload-gateway": "osv-guard vitest run ./test/upload_gateway_chain.test.js",
        "test:write-gas-estimate": "osv-guard vitest run ./test/write_gas_estimate.test.js",
        "test:item-refs-batch": "osv-guard vitest run ./test/item_refs_batch.test.js",
        "test:chunk-cache": "osv-guard vitest run ./test/chunk_cache.test.js ./test/chunk_cache_wiring.test.js",
        "test:rpc-recorder": "osv-guard vitest run ./test/rpc_recorder.test.js",
        "test:shared-contract-constants": "osv-guard vitest run ./test/shared_contract_constants.test.js",
        "test:real-ipfs": "vitest run --config vitest.real-ipfs.config.js"
    },
    "peerDependencies": {
        "viem": "^2.0.0"
    },
    "dependencies": {
        "@noble/ciphers": "^2.2.0",
        "@noble/hashes": "^2.0.0",
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "osv-guard": "^0.2.1",
        "fake-indexeddb": "^6.2.5",
        "viem": "^2.56.3",
        "vitest": "^4.1.11"
    }
}
