# Sign server for paid off-chain uploads. Omit to disable the offload UI entirely.
# VITE_PRESIGN_URL=http://localhost:8787

# Read gateway for IPFS content. Defaults (in code) to this project's own Pinata
# **dedicated** gateway already — only set this to point at a *different* Pinata
# account's dedicated gateway. Never set it back to the shared gateway.pinata.cloud:
# it aggressively rate-limits (429) ordinary app traffic — see presignProvider.js.
# VITE_IPFS_GATEWAY=https://<your-subdomain>.mypinata.cloud/ipfs/

# Adds a "Use a private key instead" option to the wallet picker: paste a raw private key
# and sign with it directly, no extension popups. Testnet-only regardless of this flag —
# see LocalSignerCard.vue. Meant for burner keys used to exercise the app or drive it as a
# test/agent account, never for a key holding anything real. Leave unset in production; when
# unset, the component and the connector it pulls in are tree-shaken out of the build
# entirely, not merely hidden.
# VITE_ENABLE_LOCAL_SIGNER=true

# Adds a "Use a passkey instead" option to the wallet picker: create or sign back into a
# real account derived entirely from a WebAuthn passkey (via @category-labs/mera) — no
# extension, no seed phrase, but also no recovery path if the passkey and every device it's
# synced to are lost. See PasskeyCard.vue and docs/wallet/passkey-accounts.md. Works on any
# network, unlike Local Signer. On by default — @category-labs/mera is still pre-1.0, not
# that the feature itself is any less safe, so this is a kill switch, not opt-in:
# VITE_ENABLE_PASSKEY_SIGNER=false
