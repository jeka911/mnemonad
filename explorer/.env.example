# Sign server for paid off-chain uploads. Omit to disable the offload UI entirely.
# VITE_PRESIGN_URL=http://localhost:8787

# Read gateway for IPFS content. Prefer a Pinata **dedicated** gateway
# (<name>.mypinata.cloud/ipfs/) over the shared gateway.pinata.cloud, which
# aggressively rate-limits (429) ordinary app traffic. See presignProvider.js.
# VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Adds a "Use a private key instead" option to the wallet picker: paste a raw private key
# and sign with it directly, no extension popups. Testnet-only regardless of this flag —
# see LocalSignerCard.vue. Meant for burner keys used to exercise the app or drive it as a
# test/agent account, never for a key holding anything real. Leave unset in production; when
# unset, the component and the connector it pulls in are tree-shaken out of the build
# entirely, not merely hidden.
# VITE_ENABLE_LOCAL_SIGNER=true
