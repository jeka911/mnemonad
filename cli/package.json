{
    "name": "mnemonad-cli",
    "version": "0.3.2",
    "description": "CLI to sync local folders to versioned, diffed on-chain streams on Monad, backed by Mnemonad + monadsync.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeka911/mnemonad.git",
        "directory": "cli"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "license": "AGPL-3.0",
    "bin": {
        "mnemonad": "./bin/mnemonad.js"
    },
    "files": [
        "bin/",
        "lib/",
        "mnemonad.config.js",
        "README.md"
    ],
    "scripts": {
        "test": "vitest run ./test/*.test.js ./test/search/*.test.js"
    },
    "dependencies": {
        "@huggingface/tokenizers": "^0.2.0",
        "@sqliteai/sqlite-vector": "^1.1.2",
        "better-sqlite3": "^13.0.3",
        "mnemonad": "workspace:^",
        "monadsync": "workspace:^",
        "open": "^11.0.4",
        "viem": "^2.56.3",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@sqliteai/sqlite-wasm": "3.50.4-wasm.1.0.0-sync.1.1.3-vector.1.1.2-memory.1.3.5",
        "mnemonad-search-transformers": "workspace:^",
        "vitest": "^4.1.11"
    }
}
