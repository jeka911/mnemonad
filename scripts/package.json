{
    "name": "mnemonad-scripts",
    "version": "0.0.1",
    "description": "Deployment scripts for Mnemonad",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeka911/mnemonad.git",
        "directory": "scripts"
    },
    "type": "module",
    "private": true,
    "scripts": {
        "sync-abi": "osv-guard node sync_abi.js",
        "deploy:testnet": "osv-guard node deploy_testnet.js",
        "deploy:mainnet": "osv-guard node deploy_mainnet.js",
        "deploy:gateway:testnet": "osv-guard node deploy_gateway_testnet.js",
        "deploy:gateway:mainnet": "osv-guard node deploy_gateway_mainnet.js",
        "push-dataset:testnet": "osv-guard node push_dataset_testnet.js",
        "update-dataset:testnet": "osv-guard node update_dataset_testnet.js",
        "collect-fees:testnet": "osv-guard node collect_fees_testnet.js",
        "collect-fees:mainnet": "node collect_fees_mainnet.js"
    },
    "license": "AGPL-3.0",
    "dependencies": {
        "viem": "^2.56.3"
    },
    "devDependencies": {
        "osv-guard": "^0.2.1"
    }
}
